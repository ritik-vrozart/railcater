# Copy to .env and fill for local or production deploy

# --- Gemini (ADK) ---
GOOGLE_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=false

# --- WhatsApp Cloud API (Meta) ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_GRAPH_API_BASE=https://graph.facebook.com
WHATSAPP_WA_ME_NUMBER=
WHATSAPP_TOKEN_FILE=data/whatsapp_token.txt
WHATSAPP_APP_ID=
WHATSAPP_APP_SECRET=

# --- Agent server ---
APP_NAME=whatsapp_train_food_agent
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Public HTTPS URL (ngrok / your domain) — webhook + /shop links, no trailing slash
PUBLIC_BASE_URL=

# Go API base URL, no trailing slash
API_BASE_URL=

# Same value as api/.env AGENT_NOTIFY_SECRET
AGENT_NOTIFY_SECRET=

# Menu placeholder image (HTTPS) when item has no image_url
DEFAULT_MENU_IMAGE_URL=

# Optional: legacy grocery payment links
PAYMENT_LINK_BASE_URL=

# Optional: help text demo train
DEMO_TRAIN_NUMBER=12951
