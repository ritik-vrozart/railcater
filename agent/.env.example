# Gemini (required for ADK agents)
GOOGLE_API_KEY=your_gemini_api_key
GOOGLE_GENAI_USE_VERTEXAI=False

# WhatsApp Cloud API (Meta)
WHATSAPP_ACCESS_TOKEN=your_meta_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_VERIFY_TOKEN=your_custom_verify_token
WHATSAPP_API_VERSION=v21.0
WHATSAPP_WA_ME_NUMBER=15551919669

# Server
APP_NAME=whatsapp_shop_agent
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Mini shop link sent in WhatsApp (use your ngrok HTTPS URL)
PUBLIC_BASE_URL=https://your-subdomain.ngrok-free.app

# Go backend API (train food: PNR, menu, orders)
API_BASE_URL=http://localhost:8080

# Must match AGENT_NOTIFY_SECRET in api/.env
AGENT_NOTIFY_SECRET=dev-notify-secret
