# Copy to .env — required for deploy

PORT=8080
DATABASE_URL=postgres://postgres:postgres@localhost:5433/whatsapp_bot?sslmode=disable
DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001

# Comma-separated allowed origins (web app URLs)
CORS_ORIGINS=http://localhost:5173

HTTP_TIMEOUT_SEC=30
JWT_SECRET=change-me-in-production
JWT_EXPIRY_HOURS=72

# Python agent — order status WhatsApp notifications
AGENT_NOTIFY_URL=http://localhost:8000/internal/notify/delivery
AGENT_NOTIFY_SECRET=
